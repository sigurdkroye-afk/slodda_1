<?xml version="1.0"?>
<sdf version="1.10">
  <model name="teddy_bear">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.025 0.3 0.3</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.025 0.3 0.3</size></box></geometry>
        <material>
          <double_sided>1</double_sided>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/teddybearsim.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.9</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
